h3 {{ L.settingsTitle }}

h4 {{ L.saveLogSection }}

.form-line
    .header
        .title {{ L.ansiTitle }}
        .description {{ L.ansiDesc }}
    select.form-control(
        [(ngModel)]='saveLog.ansiMode',
        (ngModelChange)='onSaveLogChange()'
    )
        option(ngValue='strip') {{ L.ansiStrip }}
        option(ngValue='raw') {{ L.ansiRaw }}

.form-line
    .header
        .title {{ L.autoSaveTitle }}
        .description {{ L.autoSaveDesc }}
    select.form-control(
        [(ngModel)]='saveLog.autoSave',
        (ngModelChange)='onSaveLogChange()'
    )
        option(ngValue='on') {{ L.autoSaveOn }}
        option(ngValue='ssh') {{ L.autoSaveSsh }}
        option(ngValue='off') {{ L.autoSaveOff }}

.form-line(*ngIf='saveLog.autoSave !== "off"')
    .header
        .title {{ L.directoryTitle }}
        .description {{ L.directoryDesc }}
    .input-group
        input.form-control(
            type='text',
            [placeholder]='L.homeDirectoryPlaceholder',
            [(ngModel)]='saveLog.autoSaveDirectory',
            (ngModelChange)='onSaveLogChange()'
        )
        .input-group-append
            button.btn.btn-secondary((click)='pickDirectory()')
                i.fas.fa-folder-open

h4.mt-4 {{ L.highlightSection }}

p.text-muted {{ L.highlightHelp }}

.form-line(*ngFor='let color of config.store.uartKit.highlight.colors; let i = index')
    .header
        .title {{ slotTitle(i) }}
        .description {{ L.slotBgDesc }}
    .input-group
        input.form-control(
            type='text',
            [placeholder]='L.lightPlaceholder',
            [(ngModel)]='color.light',
            (ngModelChange)='onHighlightChange()'
        )
        input.form-control(
            type='text',
            [placeholder]='L.darkPlaceholder',
            [(ngModel)]='color.dark',
            (ngModelChange)='onHighlightChange()'
        )

.form-line
    .header
        .title {{ L.hotkeysTitle }}
        .description {{ L.hotkeysDesc }}
    p.mb-0 {{ L.hotkeyToggleHelp }}
    p.mb-0 {{ L.hotkeyClearHelp }}
